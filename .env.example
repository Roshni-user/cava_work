# Copy this file to .env and replace the placeholders.
# Prisma and the Next.js app read DATABASE_URL.
# Point it at a local PostgreSQL database that already exists.

DATABASE_URL="postgresql://postgres:change-me@localhost:5432/cavli?schema=public"

# Public MMI catalogue endpoint. No credentials are required.
MMI_GRAPHQL_URL=https://mmiconnect.in/graphql
MMI_CATALOGUE_GROUP=ep-blr-2026
MMI_PAGE_SIZE=100
MMI_DETAIL_CONCURRENCY=4

# Weekday consultation hours are 10:00–17:00 in this timezone. 30-minute slots.
CONSULTATION_TIMEZONE=Asia/Kolkata

# Google Calendar and Resend. Put real values in .env.local, not in this file.
# These lines are names and placeholders only.
#
# Required with either authentication method:
#   GOOGLE_CALENDAR_ID
# OAuth method, preferred when the visitor must be an attendee and Meet is required:
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   GOOGLE_REFRESH_TOKEN
# Service-account method, only if that account can create Meet conferences on the calendar:
#   GOOGLE_CLIENT_EMAIL
#   GOOGLE_PRIVATE_KEY
# Resend, both required to send the confirmation email:
#   RESEND_API_KEY
#   EMAIL_FROM
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Cavli Wireless <consultations@example.com>
